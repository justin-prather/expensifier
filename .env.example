BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ORIGIN=http://localhost:3000

# Local development defaults to ./data. Docker Compose overrides this to /data.
APP_DATA_ROOT=./data

# Optional relative overrides. Every managed path must remain beneath APP_DATA_ROOT.
# APP_INBOX_PATH=inbox
# APP_PROCESSING_PATH=processing
# APP_PROCESSED_PATH=processed
# APP_REJECTED_PATH=rejected
# APP_BACKUPS_PATH=backups

# Intake files must remain unchanged for this long before ingestion.
# INTAKE_STABLE_MILLISECONDS=2000
# INTAKE_SCAN_INTERVAL_MILLISECONDS=10000
# JOB_POLL_INTERVAL_MILLISECONDS=500
# JOB_MAX_ATTEMPTS=3

# Taggun is the production OCR provider. Without a key, ingested documents remain visible
# with a recoverable configuration failure and can be retried after configuration.
TAGGUN_API_KEY=
# TAGGUN_ENDPOINT=https://api.taggun.io/api/receipt/v1/verbose/file
# OCR_TIMEOUT_MILLISECONDS=30000
# OCR_MAX_FILE_BYTES=20000000
# OCR_MAX_RESPONSE_BYTES=5000000

# OpenCode Zen classification receives normalized structured OCR fields and configured candidate values only.
# Without a key, review remains available and classification can be retried after configuration.
CLASSIFICATION_API_KEY=
# CLASSIFICATION_ENDPOINT=https://opencode.ai/zen/v1/chat/completions
# CLASSIFICATION_MODEL=deepseek-v4-flash
# CLASSIFICATION_TIMEOUT_MILLISECONDS=20000
# CLASSIFICATION_MAX_RESPONSE_BYTES=1000000

# Host directory mounted at /data by Docker Compose.
DOCKER_DATA_ROOT=./data
